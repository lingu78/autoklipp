    "Apple Intelligence could not follow your description, so the film was made without it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kunde inte följa din beskrivning, så filmen gjordes utan den."
          }
        }
      }
    },
    "Apple Intelligence picks and orders the clips on your device. Only short descriptions of the clips are used, never the pictures.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence väljer och ordnar klippen på din enhet. Bara korta beskrivningar av klippen används, aldrig bilderna."
          }
        }
      }
    },
